# ══════════ 阅读伴侣后端环境变量 ══════════
# 复制为 .env 并填写（Render 上直接在 Environment 面板配置）

# 服务端口（Render 会自动注入 PORT，无需手动设置）
PORT=8787

# JWT 签名密钥：随便一串长随机字符串，生产环境务必更换
JWT_SECRET=change-me-to-a-long-random-string

# 数据库：Render PostgreSQL 的 External/Internal Database URL
# 不设置时自动使用本地 SQLite（server/data/dev.sqlite3），仅供开发
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# 允许跨域来源，逗号分隔；* 表示全部放行（联调期可用 *）
CORS_ORIGIN=*

# ── Injective EVM 上链存证（不配置则跳过上链，其余功能正常） ──
# 测试网 RPC
INJ_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
# 后端代签钱包私钥（0x 开头，去水龙头 https://testnet.faucet.injective.network/ 领测试币）
# CHAIN_PRIVATE_KEY=0x...
# BookRegistry 合约地址（npm run deploy:contract 部署后填入）
# BOOK_REGISTRY_ADDRESS=0x...
# 区块浏览器（用于给前端拼交易链接）
CHAIN_EXPLORER=https://testnet.blockscout.injective.network

# ── 阶跃星辰 AI（问书功能，不配置则 AI 问答不可用） ──
# 控制台 https://platform.stepfun.com/ 创建 API Key
STEP_API_KEY=
# 模型，默认 step-3.7-flash
STEP_MODEL=step-3.7-flash
